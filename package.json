{
  "name": "build-and-battle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-static.mjs --watch & npx --yes serve -l 5173 .",
    "build": "node scripts/build-static.mjs",
    "build:check": "tsc -b --pretty false",
    "lint": "oxlint",
    "preview": "npx --yes serve -l 4173 .",
    "deploy": "node scripts/build-static.mjs && npx gh-pages -d . -s 'index.html,app/**,favicon.svg,README.md'"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "trystero": "^0.25.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
